# DAOUFYS TRANSIT — Voice Agent Configuration
# Copy to .env and fill in your keys

# =============================================================================
# LIVEKIT CLOUD (Required)
# Get from: https://cloud.livekit.io/projects
# =============================================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# =============================================================================
# AI PROVIDERS (Required - choose your stack)
# =============================================================================

# Option A: LiveKit Inference (simplest, uses LiveKit Cloud credits)
# LIVEKIT_INFERENCE_STT=deepgram/nova-3
# LIVEKIT_INFERENCE_LLM=google/gemma-4-31b-it
# LIVEKIT_INFERENCE_TTS=cartesia/sonic-3

# Option B: Direct Provider APIs (more control, your own keys)
# Deepgram STT - Best for Arabic/Darija
DEEPGRAM_API_KEY=your_deepgram_key_here

# OpenAI LLM - For reasoning + tool calling
OPENAI_API_KEY=your_openai_key_here

# Cartesia TTS - Good multilingual voices
CARTESIA_API_KEY=your_cartesia_key_here

# MiniMax TTS - BEST for Darija (speech-02-hd) - RECOMMENDED
# MINIMAX_API_KEY=your_minimax_key_here
# MINIMAX_GROUP_ID=your_group_id_here

# ElevenLabs TTS - Alternative, needs voice cloning for Darija
# ELEVENLABS_API_KEY=your_elevenlabs_key_here

# =============================================================================
# HERMES INTEGRATION (Optional - for complex task delegation)
# =============================================================================
HERMES_GATEWAY_URL=http://localhost:8000
HERMES_API_KEY=your_hermes_gateway_key_here

# =============================================================================
# DAOUFYS BUSINESS CONFIG (Already in code, override if needed)
# =============================================================================
# DAOUFYS_LICENSE_NUMBER=1426
# DAOUFYS_PHONE_MAIN=+212528292533
# DAOUFYS_EMAIL=direction@daoufystransit.com

# =============================================================================
# DEPLOYMENT
# =============================================================================
# For LiveKit Cloud deployment
LIVEKIT_AGENT_DEPLOYMENT=production
LIVEKIT_AGENT_NAME=daoufys-receptionist

# For local development
# LIVEKIT_AGENT_DEPLOYMENT=development